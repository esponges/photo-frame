# --- Google Drive (service account) ---
# Create a GCP project, enable the Drive API, create a service account, download the
# JSON key, then SHARE THE DRIVE FOLDER with the service account's email (Viewer).
GOOGLE_SERVICE_ACCOUNT_EMAIL=frame-reader@your-project.iam.gserviceaccount.com
# Paste the key's private_key value verbatim, newlines as \n, wrapped in quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The folder id from its Drive URL: drive.google.com/drive/folders/<THIS>
DRIVE_FOLDER_ID=

# --- Secrets ---
# Shared secret the tablet sends as `Authorization: Bearer <...>`
FRAME_TOKEN=
# Password for the /admin page
ADMIN_PASSWORD=

# --- Optional: Upstash Redis for settings/hidden/commands state ---
# Omit entirely during local dev and an in-memory store is used instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Optional: serve generated test media instead of Drive (see README) ---
# FIXTURE_MODE=1
