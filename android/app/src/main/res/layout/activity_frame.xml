<?xml version="1.0" encoding="utf-8"?>
<!--
  Three stacked layers, bottom to top:
    backdrop  - the 60x96 blurred image, stretched to fill. Bilinear upscaling IS
                the blur, so the Adreno 320 does no real work.
    photoA/B  - two ImageViews cross-faded against each other.
    scrim     - gradient + caption + date.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- Bottom of the stack on purpose: a video's surface punches a hole through
         everything drawn before it, so with the photos above it the previous photo
         stays on screen while a clip prepares, and is only faded out once the clip
         is really advancing. -->
    <VideoView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/photoA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/photoB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="56dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:padding="12dp"
        android:textColor="#88FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
