<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only; shadows src/main's file of the same name.

  Same trust anchors as main, plus cleartext to the dev machine's server, which the
  tablet reaches through `adb reverse tcp:3000 tcp:3000` (see backend FIXTURE_MODE).
  Release builds keep the HTTPS-only config.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
